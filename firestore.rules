rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validContact() {
      return request.resource.data.realName is string
        && request.resource.data.realName.size() >= 1
        && request.resource.data.realName.size() <= 50
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[016789][0-9]{7,8}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.betaContactConsent is bool;
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow list: if admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username','email','phone','createdAt','realName','betaContactConsent'])
        && request.resource.data.keys().hasAll(['username','email','phone','createdAt','realName','betaContactConsent'])
        && validContact()
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9]{4,20}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['realName','phone','email','betaContactConsent'])
        && validContact();
      allow delete: if false;
      match /career/{document=**} {
        allow read, create, update: if owner(uid);
        allow delete: if false;
      }
      match /activity/{day} {
        allow get, list: if owner(uid) || admin();
        allow create, update: if owner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['lastSeenAt'])
          && request.resource.data.keys().hasAll(['lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
        allow delete: if false;
      }
      match /summary/play {
        allow get: if owner(uid) || admin();
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['matches','wallet','squad','cards','packs','supply','beta1','beta2','collection','updatedAt'])
          && request.resource.data.keys().hasAll(['matches','wallet','squad','cards','packs','supply','beta1','beta2','collection','updatedAt'])
          && request.resource.data.matches is int && request.resource.data.matches >= 0
          && request.resource.data.wallet is number && request.resource.data.wallet >= 0 && request.resource.data.wallet <= 1000000000000000
          && request.resource.data.squad is int && request.resource.data.squad >= 0
          && request.resource.data.cards is int && request.resource.data.cards >= 0
          && request.resource.data.packs is int && request.resource.data.packs >= 0
          && request.resource.data.supply in ['absent','pending','claimed']
          && request.resource.data.beta1 in ['absent','pending','claimed']
          && request.resource.data.beta2 in ['absent','pending','claimed']
          && request.resource.data.collection in ['absent','pending','claimed']
          && request.resource.data.updatedAt == request.time;
        allow list, delete: if false;
      }
      match /summary/current {
        allow get: if owner(uid) || admin();
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly(['coachName','level','portraitId','clubName','season','round','updatedAt'])
          && request.resource.data.keys().hasAll(['coachName','level','portraitId','clubName','season','round','updatedAt'])
          && request.resource.data.coachName is string && request.resource.data.coachName.size() <= 80
          && request.resource.data.clubName is string && request.resource.data.clubName.size() <= 100
          && request.resource.data.level is int && request.resource.data.level >= 1 && request.resource.data.level <= 100000
          && request.resource.data.portraitId is int && request.resource.data.portraitId >= -1 && request.resource.data.portraitId <= 35
          && request.resource.data.season is string && request.resource.data.season.size() <= 40
          && request.resource.data.round is int && request.resource.data.round >= 0 && request.resource.data.round <= 100000
          && request.resource.data.updatedAt == request.time;
        allow list, delete: if false;
      }
    }
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow list, update, delete: if false;
    }
    function validPost() {
      return request.resource.data.keys().hasOnly(['category','title','body','author','published','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['category','title','body','author','published','createdAt','updatedAt'])
        && request.resource.data.category in ['events','notice','community','guide']
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 10000
        && request.resource.data.author is string && request.resource.data.author.size() <= 50
        && request.resource.data.published is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /publicPosts/{postId} {
      allow get, list: if admin() || resource.data.published == true;
      allow create: if validPost() && request.resource.data.createdAt == request.time
        && admin() && request.resource.data.author == 'ELEVOS 운영팀';
      allow update: if admin() && validPost()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.author == resource.data.author
        && request.resource.data.category == resource.data.category;
      allow delete: if admin();
    }
    // Anonymous browser/day markers; no page URLs or personal data.
    match /siteVisitors/{visitId} {
      allow create: if visitId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow get, list: if admin();
      allow update, delete: if false;
    }
    // Permanent manager-name reservations; no public listing or reassignment.
    match /coachNames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9가-힣]{2,12}$')
        && !name.matches('.*(시발|씨발|씨팔|병신|좆|개새끼|미친놈|미친년|지랄|fuck|shit|bitch|admin|운영자|관리자|운영팀).*')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow list, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}