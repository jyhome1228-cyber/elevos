rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function admin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || admin();
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['username','email','phone','createdAt','realName','betaContactConsent'])
        && request.resource.data.keys().hasAll(['username','email','phone','createdAt','realName','betaContactConsent'])
        && request.resource.data.realName is string
        && request.resource.data.realName.size() >= 1
        && request.resource.data.realName.size() <= 50
        && request.resource.data.betaContactConsent is bool
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9]{4,20}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[016789][0-9]{7,8}$')
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow list: if admin();
      allow update, delete: if false;
      match /career/{document=**} {
        allow read, create, update: if owner(uid);
        allow delete: if false;
      }
    }
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
        && name.matches('^[a-z0-9]{4,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow list, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}